# Copy to .env for a host run (`docker compose up db` plus `uv run ...`).
# .env is local only and never committed. Real environment variables win over it.
# compose.yaml does not need this file: it sets its own values for the containers.
#
# URLs use plain postgresql:// (no driver suffix). Percent encode any password
# that contains URL special characters.

# The app's role: read and write on claim data, claims system and checkpoints.
DATABASE_URL=postgresql://claim_app:claim_app@localhost:5432/claim_intake

# Used only by the migrate job (python -m claim_intake.db.migrate).
MIGRATE_DATABASE_URL=postgresql://claim_owner:claim_owner@localhost:5432/claim_intake
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Tests. The database name must end in _test; the test run creates it if missing.
TEST_DATABASE_URL=postgresql://claim_app:claim_app@localhost:5432/claim_intake_test

# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# If port 5432 is taken on your machine, set DB_PORT for compose and change the
# port in the URLs above to match.
# DB_PORT=5432
